# Local Python/Vite development defaults. Production Docker requires the
# deployment values below; do not deploy this file unchanged.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=glovebox
SESSION_TTL_DAYS=7
API_DOCS_ENABLED=true
SETUP_TOKEN_REQUIRED=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=http://localhost:8000

REMINDER_WORKER_ENABLED=true
REMINDER_CHECK_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# The bundled frontend serves ordinary HTTP on localhost:5173.
# Keep it loopback-only unless an external HTTP reverse proxy is configured.
HTTP_BIND_ADDRESS=127.0.0.1

# Required application secret. Generate it with `openssl rand -hex 32`.
# SETUP_TOKEN=replace-with-a-generated-secret
