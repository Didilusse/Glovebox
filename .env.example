# Example environment variables for local development

# Backend (FastAPI/Beanie)
# MongoDB connection URI - change to your Mongo host if not running locally
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=glovebox
# How long login sessions stay valid (days)
SESSION_TTL_DAYS=30

# Required for Docker deployment. Generate with: openssl rand -hex 32
# Enter this secret in the first-run setup screen; never use a VITE_ prefix.
# SETUP_TOKEN=replace-with-your-generated-secret
# Set true for any network-accessible non-Docker backend too.
SETUP_TOKEN_REQUIRED=false
# JSON array; production Docker requests use the same-origin /api proxy.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend (Vite)
# Local Vite overrides belong in frontend/.env.local, not this root file.
# Docker builds default to /api.
VITE_API_BASE_URL=http://localhost:8000
